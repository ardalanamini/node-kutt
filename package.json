{
  "name": "kutt",
  "version": "3.0.2",
  "description": "Node.js & browser (TypeScript) client for Kutt url shortener",
  "author": "Ardalan Amini <ardalanamini22@gmail.com> (https://ardalanamini.com)",
  "license": "MIT",
  "homepage": "https://kutt.to",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardalanamini/node-kutt.git"
  },
  "bugs": {
    "url": "https://github.com/ardalanamini/node-kutt/issues"
  },
  "keywords": [
    "kutt",
    "url",
    "shortener"
  ],
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "engines": {
    "node": ">= 16.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "pnpm build --watch",
    "lint": "oxlint",
    "lint:fix": "pnpm lint --fix",
    "test": "echo \"Error: no test specified\" && exit 1",
    "document": "typedoc",
    "knip": "knip",
    "prepack": "pnpm build",
    "prepare": "is-ci || lefthook install"
  },
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "imports": {
      "#src/*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@types/node": "26.6.5",
    "is-ci": "4.1.0",
    "knip": "6.42.1",
    "lefthook": "2.2.2",
    "oxlint": "1.89.0",
    "oxlint-config-noir": "1.0.8",
    "oxlint-tsgolint": "7.0.2004",
    "typedoc": "0.28.20",
    "typescript": "7.0.2"
  }
}
