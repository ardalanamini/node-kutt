{
  "name": "kutt",
  "version": "3.0.2",
  "description": "Node.js & browser (TypeScript) client for Kutt url shortener",
  "author": "Ardalan Amini <ardalanamini22@gmail.com> (https://ardalanamini.com)",
  "license": "MIT",
  "homepage": "https://kutt.to",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardalanamini/node-kutt.git"
  },
  "bugs": {
    "url": "https://github.com/ardalanamini/node-kutt/issues"
  },
  "keywords": [
    "kutt",
    "url",
    "shortener"
  ],
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "engines": {
    "node": ">= 16.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "build:watch": "pnpm build --watch",
    "lint": "eslint src",
    "lint:fix": "pnpm lint --fix",
    "document": "typedoc",
    "prepack": "pnpm build"
  },
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "imports": {
      "#src/*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "devDependencies": {
    "@types/node": "^18.11.0",
    "@typescript-eslint/eslint-plugin": "^5.40.0",
    "@typescript-eslint/parser": "^5.40.0",
    "eslint": "^8.25.0",
    "eslint-config-noir": "^1.3.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.26.0",
    "typedoc": "^0.23.16",
    "typescript": "^4.8.4"
  }
}
