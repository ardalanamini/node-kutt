{
  "languages": {
    "JavaScript": {
      "language_servers": ["!eslint", "..."],
      "format_on_save": "on",
      "prettier": {
        "allowed": false,
      },
      "formatter": [],
      "code_actions_on_format": {
        "source.fixAll.oxc": true,
      },
    },
    "TypeScript": {
      "language_servers": [
        "!eslint",
        "!vtsls",
        "!typescript-language-server",
        "typescript-ls",
        "...",
      ],
      "format_on_save": "on",
      "prettier": {
        "allowed": false,
      },
      "formatter": [],
      "code_actions_on_format": {
        "source.fixAll.oxc": true,
      },
    },
    "TSX": {
      "language_servers": [
        "!eslint",
        "!vtsls",
        "!typescript-language-server",
        "typescript-ls",
        "...",
      ],
      "format_on_save": "on",
      "prettier": {
        "allowed": false,
      },
      "formatter": [],
      "code_actions_on_format": {
        "source.fixAll.oxc": true,
      },
    },
  },
  "lsp": {
    "oxlint": {
      "initialization_options": {
        "settings": {
          "configPath": "./oxlint.config.ts",
          "tsConfigPath": "./tsconfig.json",
          "typeAware": true,
          "disableNestedConfig": false,
          "fixKind": "safe_fix_or_suggestion",
          "run": "onType",
          "unusedDisableDirectives": "deny",
        },
      },
    },
  },
  "file_scan_exclusions": ["...", "node_modules", "dist", "docs"],
}
